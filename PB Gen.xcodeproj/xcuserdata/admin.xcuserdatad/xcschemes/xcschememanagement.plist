+++ b/PB Gen/Models/AmericanoScheduler.swift	
@@ -0,0 +1,111 @@
+import Foundation
+
+struct AmericanoScheduler {
+    let players: [String]
+    var numberOfRounds: Int
+    let numberOfCourts: Int
+    let seed: UInt64
+    private var rng: SeededRandomNumberGenerator
+    private var partnerHistory: [String: [String: Int]] = [:]
+    private var opponentHistory: [String: [String: Int]] = [:]
+    private var lastRestRound: [String: Int] = [:]
+    private var restingPlayersByRound: [Int: [String]] = [:]
+    
+    init(players: [String], numberOfRounds: Int, numberOfCourts: Int, seed: UInt64) {
+        self.players = players
+        self.numberOfRounds = numberOfRounds
+        self.numberOfCourts = numberOfCourts
+        self.seed = seed
+        self.rng = SeededRandomNumberGenerator(seed: seed)
+        self.lastRestRound = Dictionary(uniqueKeysWithValues: players.map { ($0, -1) })
+    }
+    
+    mutating func generateSchedule() -> ([Match], [Int: [String]]) {
+        var schedule: [Match] = []
+        restingPlayersByRound = [:]
+        
+        for round in 0..<numberOfRounds {
+            let (roundMatches, restingPlayers) = generateRound(round: round)
+            schedule.append(contentsOf: roundMatches)
+            restingPlayersByRound[round] = restingPlayers
+        }
+        
+        return (schedule, restingPlayersByRound)
+    }
+    
+    mutating func generateAdditionalRound(existingSchedule: [Match]) -> ([Match], [String]) {
+        let newRound = (existingSchedule.last?.round ?? -1) + 1
+        numberOfRounds += 1
+        let (newMatches, restingPlayers) = generateRound(round: newRound)
+        restingPlayersByRound[newRound] = restingPlayers
+        return (newMatches, restingPlayers)
+    }
+    
+    private mutating func generateRound(round: Int) -> ([Match], [String]) {
+        var availablePlayers = players.shuffled(using: &rng)
+        var roundMatches: [Match] = []
+        
+        let maxMatches = min(numberOfCourts, availablePlayers.count / 4)
+        
+        var restingPlayers: [String] = []
+        if availablePlayers.count > maxMatches * 4 {
+            let playersToRest = availablePlayers.count - maxMatches * 4
+            restingPlayers = selectPlayersToRest(availablePlayers, playersToRest, round)
+            availablePlayers = availablePlayers.filter { !restingPlayers.contains($0) }
+            
+            for player in restingPlayers {
+                lastRestRound[player] = round
+            }
+        }
+        
+        while availablePlayers.count >= 4 {
+            let team1 = selectTeam(from: &availablePlayers)
+            let team2 = selectTeam(from: &availablePlayers)
+            
+            updatePartnerHistory(team: team1)
+            updatePartnerHistory(team: team2)
+            updateOpponentHistory(team1: team1, team2: team2)
+            
+            let match = Match(id: UUID(), round: round, court: roundMatches.count + 1, team1: team1, team2: team2)
+            roundMatches.append(match)
+        }
+        
+        return (roundMatches, restingPlayers)
+    }
+    
+    private mutating func selectPlayersToRest(_ availablePlayers: [String], _ count: Int, _ currentRound: Int) -> [String] {
+        return availablePlayers
+            .sorted { lastRestRound[$0, default: -1] < lastRestRound[$1, default: -1] }
+            .prefix(count)
+            .shuffled(using: &rng)
+    }
+    
+    private mutating func selectTeam(from players: inout [String]) -> Team {
+        let player1 = players.removeFirst()
+        let player2 = players.min { a, b in
+            let aPartnerships = partnerHistory[player1, default: [:]][a, default: 0]
+            let bPartnerships = partnerHistory[player1, default: [:]][b, default: 0]
+            if aPartnerships == bPartnerships {
+                return opponentHistory[player1, default: [:]][a, default: 0] < opponentHistory[player1, default: [:]][b, default: 0]
+            }
+            return aPartnerships < bPartnerships
+        } ?? players.randomElement(using: &rng)!
+        players.removeAll { $0 == player2 }
+        
+        return Team(player1: player1, player2: player2)
+    }
+    
+    private mutating func updatePartnerHistory(team: Team) {
+        partnerHistory[team.player1, default: [:]][team.player2, default: 0] += 1
+        partnerHistory[team.player2, default: [:]][team.player1, default: 0] += 1
+    }
+    
+    private mutating func updateOpponentHistory(team1: Team, team2: Team) {
+        let allPlayers = [team1.player1, team1.player2, team2.player1, team2.player2]
+        for player in allPlayers {
+            for opponent in allPlayers where opponent != player {
+                opponentHistory[player, default: [:]][opponent, default: 0] += 1
+            }
+        }
+    }
+}
