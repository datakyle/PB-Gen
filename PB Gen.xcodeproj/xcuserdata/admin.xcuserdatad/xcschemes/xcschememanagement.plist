+struct RestingPlayersView: View {
+    let players: [String]
+    
+    var body: some View {
+        Text("Resting: \(players.joined(separator: ", "))")
+            .font(.subheadline)
+            .foregroundColor(.secondary)
+            .padding(.top, 5)
+            .transition(.opacity)
+    }
+}
+
+struct RoundDetailView: View {
+    @Binding var matches: [Match]
+    let round: Int
+    let pointsPerWin: Int
+    let updateLeaderboard: (Team, Team, Int) -> Void
+    
+    var body: some View {
+        List {
+            Section {
+                Text("Tap on a team to select the winner.")
+                    .font(.subheadline)
+                    .foregroundColor(.secondary)
+                    .padding(.vertical, 8)
+            }
+            
+            ForEach(matches.indices.filter { matches[$0].round == round }, id: \.self) { index in
+                let matchBinding = $matches[index]
+                Section(header: Text("Court \(matchBinding.court.wrappedValue)")) {
+                    MatchWinnerView(match: matchBinding, pointsPerWin: pointsPerWin, updateLeaderboard: updateLeaderboard)
+                }
+            }
+        }
+        .navigationTitle("Round \(round + 1)")
+        .onAppear {
+            print("RoundDetailView appeared for Round \(round + 1)")
+            print("Total matches: \(matches.count)")
+            print("Matches in this round: \(matches.filter { $0.round == round }.count)")
+        }
+    }
+}
+
+struct MatchWinnerView: View {
+    @Binding var match: Match
+    let pointsPerWin: Int
+    let updateLeaderboard: (Team, Team, Int) -> Void
+    
+    var body: some View {
+        VStack(spacing: 20) {
+            TeamButtonView(team: match.team1, isWinner: match.team1Score > 0) {
+                selectWinner(team: match.team1, opponent: match.team2)
+            }
+            
+            TeamButtonView(team: match.team2, isWinner: match.team2Score > 0) {
+                selectWinner(team: match.team2, opponent: match.team1)
+            }
+        }
+        .padding()
+    }
+    
+    private func selectWinner(team: Team, opponent: Team) {
+        let previousWinner = match.team1Score > 0 ? match.team1 : (match.team2Score > 0 ? match.team2 : nil)
+        
+        if team == match.team1 {
+            match.team1Score = 1
+            match.team2Score = 0
+        } else {
+            match.team1Score = 0
+            match.team2Score = 1
+        }
+        
+        if let previousWinner = previousWinner, previousWinner != team {
+            // Undo previous winner's points
+            updateLeaderboard(previousWinner, team, -pointsPerWin)
+        }
+        
+        if previousWinner == nil || previousWinner != team {
+            // Add points for new winner
+            updateLeaderboard(team, opponent, pointsPerWin)
+        }
+    }
+}
+
+struct TeamButtonView: View {
+    let team: Team
+    let isWinner: Bool
+    let action: () -> Void
+    
+    var body: some View {
+        Button(action: action) {
+            HStack {
+                Text("\(team.player1) & \(team.player2)")
+                Spacer()
+                if isWinner {
+                    Image(systemName: "checkmark.circle.fill")
+                        .foregroundColor(.green)
+                        .transition(.scale.combined(with: .opacity))
+                }
+            }
+            .padding()
+            .background(isWinner ? Color.green.opacity(0.2) : Color.secondary.opacity(0.1))
+            .cornerRadius(10)
+            .overlay(
+                RoundedRectangle(cornerRadius: 10)
+                    .stroke(isWinner ? Color.green : Color.clear, lineWidth: 2)
+            )
+        }
+        .buttonStyle(PlainButtonStyle())
+    }
+}
