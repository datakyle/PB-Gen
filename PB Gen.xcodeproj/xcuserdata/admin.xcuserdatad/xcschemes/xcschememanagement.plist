+        self.round = round
+        self.court = court
+        self.team1 = team1
+        self.team2 = team2
+    }
+    
+    static func == (lhs: Match, rhs: Match) -> Bool {
+        lhs.id == rhs.id &&
+        lhs.round == rhs.round &&
+        lhs.court == rhs.court &&
+        lhs.team1 == rhs.team1 &&
+        lhs.team2 == rhs.team2 &&
+        lhs.team1Score == rhs.team1Score &&
+        lhs.team2Score == rhs.team2Score
+    }
+}
+
+struct Team: Codable, Equatable {
+    let player1: String
+    let player2: String
